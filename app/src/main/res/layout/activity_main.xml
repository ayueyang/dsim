<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EFEFEF"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="40dp">

        <Button
            android:id="@+id/btnRequestDefaultSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="1. 设为默认短信应用" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnInsertFakeSms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="2. 注入幽灵短信" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReadAllHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="4. 读取本机所有历史短信" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#CCCCCC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCheckRoot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="检查/请求 Root" />

            <TextView
                android:id="@+id/tvRootStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:text="Root状态: 未知"
                android:textColor="#FF0000"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="=== 云端暗号配对 (MQTT) ==="
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="8dp">
            
            <EditText
                android:id="@+id/etMqttBroker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="云端节点 (默认 tcp://broker.emqx.io:1883)"
                android:text="tcp://broker.emqx.io:1883"
                android:textSize="14sp"/>
                
            <EditText
                android:id="@+id/etMqttTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="路由频道 (如 dsim_channel_001)"
                android:textSize="14sp"/>
                
            <EditText
                android:id="@+id/etMqttPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="端到端加密密钥 (极其重要，打死别泄露)"
                android:inputType="textPassword"
                android:textColor="#F44336"
                android:textSize="14sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnConnectCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="接入云端频道" />

        <Switch
            android:id="@+id/switchAutoConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="⚡ 开机自动静默连线并常驻后台"
            android:textColor="#333333"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnPushIncremental"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="增量同步 (仅新数据)"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPushFullHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="全量补发 (极其耗时)"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="硬件可行性探测" />
            
        <Button
            android:id="@+id/btnManageSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIM卡绑定管理 (手动解绑)"
            android:layout_marginTop="8dp"/>
            
        <Button
            android:id="@+id/btnToggleRootMock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关闭 Root 探测 (开启无 Root 测试)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnClearSmsDb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空私有数据库 (仅删除短信)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F44336"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnToggleMute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="通知状态：🔔 响铃与弹窗"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTestNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🚨 触发本地模拟通知 (测试声音与弹窗)"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRadar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📡 探测云端在线节点"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="=== 日志输出区 ==="
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:padding="8dp"
            android:text="等待指令..."
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#333333"
            android:background="#F0F0F0" />

    </LinearLayout>

</ScrollView>
