<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sender_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_sender_sheet_handle" />

    <TextView
        android:id="@+id/tvConversationActionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="会话操作"
        android:textColor="#121826"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvConversationActionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="设置置顶优先级，1 最高，数字越大越靠后。"
        android:textColor="#7A8696"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPinPriority"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_profile_input"
        android:hint="置顶优先级：1-99，空白或 0 取消"
        android:includeFontPadding="false"
        android:inputType="number"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#17212B"
        android:textColorHint="#9AA3AF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvPinPriorityHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="相同优先级允许并列，并列会话按最新消息排序。"
        android:textColor="#9AA3AF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvClearPinPriority"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_profile_secondary_button"
            android:gravity="center"
            android:text="取消置顶"
            android:textColor="#123B48"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSavePinPriority"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_profile_primary_button"
            android:gravity="center"
            android:text="保存置顶"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEditConversationProfile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_profile_secondary_button"
        android:gravity="center"
        android:text="编辑会话资料"
        android:textColor="#123B48"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCancelConversationAction"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="取消"
        android:textColor="#64707F"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
