<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F5F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="信息"
                    android:textColor="#121826"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:includeFontPadding="false"
                    android:text="dSIM 多卡短信同步"
                    android:textColor="#7A8696"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnOpenSettings"
                android:layout_width="86dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_home_settings_button"
                android:clickable="true"
                android:drawableStart="@drawable/ic_home_settings"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="设置"
                android:textColor="#123B48"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setupGuideContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_home_setup_card"
        android:elevation="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSetupGuideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="完成基础配置"
            android:textColor="#3B2C12"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSetupGuideStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="1dp"
            android:textColor="#7A5B20"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSetupGuideSettings"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_home_setup_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="进入设置"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="108dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNewConversation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="新建会话"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#123B48"
            app:elevation="7dp"
            app:fabSize="normal"
            app:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
