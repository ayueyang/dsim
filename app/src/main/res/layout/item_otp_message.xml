<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#E7ECF2"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="15dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOtpSender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#17212B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOtpTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:includeFontPadding="false"
                    android:textColor="#9AA3AF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOtpSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="#8A94A3"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOtpCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:textColor="#123B48"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyOtp"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="92dp"
                    android:layout_height="44dp"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="复制"
                    android:textAllCaps="false"
                    android:textColor="#123B48"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#EAF0F7"
                    app:cornerRadius="22dp"
                    app:elevation="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOtpLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:textColor="#64707F"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvOtpBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="4"
                android:textColor="#64707F"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/tvExpandOtp"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_otp_expand_button"
                android:clickable="true"
                android:contentDescription="打开原短信"
                android:focusable="true"
                android:padding="5dp"
                android:scaleType="center"
                android:src="@drawable/ic_otp_expand_down" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
