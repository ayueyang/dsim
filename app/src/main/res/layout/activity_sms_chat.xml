<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="18dp">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_nav_back_button"
            android:contentDescription="返回"
            android:padding="10dp"
            android:scaleType="center"
            android:src="@drawable/ic_nav_back" />

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#17212B"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F6F8"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_input_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnSelectSim"
                android:layout_width="112dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chat_sender_button"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="&#36873;&#25321;&#21457;&#20449;&#21495;&#30721;"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSmsInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input_field"
                android:hint="&#36755;&#20837;&#30701;&#20449;..."
                android:includeFontPadding="false"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#17212B"
                android:textColorHint="#9AA3AF"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnSendSms"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chat_send_button"
                android:contentDescription="&#21457;&#36865;"
                android:padding="10dp"
                android:scaleType="center"
                android:src="@drawable/ic_chat_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
