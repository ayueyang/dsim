<?xml version="1.0" encoding="utf-8"?>
<!--
  Deny-by-default for API 31+. Two independent channels, both must be denied:
  <cloud-backup> is the Google Drive path, <device-transfer> is device-to-device migration and is
  NOT covered by android:allowBackup, so it needs its own exclusions.

  device_* domains cover credential-encrypted storage; this app does not use it today, but they are
  listed so the rules stay correct if that changes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
