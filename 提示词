// 📡 1. 处理雷达探测广播 (PING)
if (action == "PING" && senderId != localDeviceId) {
    serviceScope.launch {
        try {
            // 抓取电池信息
            val bm = getSystemService(android.content.Context.BATTERY_SERVICE) as android.os.BatteryManager
            val batteryLevel = bm.getIntProperty(android.os.BatteryManager.BATTERY_PROPERTY_CAPACITY)
            val intentFilter = android.content.IntentFilter(android.content.Intent.ACTION_BATTERY_CHANGED)
            val batteryStatus = registerReceiver(null, intentFilter)
            val status = batteryStatus?.getIntExtra(android.os.BatteryManager.EXTRA_STATUS, -1) ?: -1
            val isCharging = status == android.os.BatteryManager.BATTERY_STATUS_CHARGING || status == android.os.BatteryManager.BATTERY_STATUS_FULL

            // 抓取短信大权状态
            val isDefaultSms = com.example.dsim.DefaultSmsManager.isDefaultSmsApp(this@MqttSyncService)

            // 抓取活跃的 SIM 卡花名册
            val dao = com.example.dsim.database.DsimDatabase.getDatabase(this@MqttSyncService).dsimDao()
            val activeSims = dao.getActiveSimConfigs()
            val simsJsonArray = org.json.JSONArray()
            for (sim in activeSims) {
                val simObj = org.json.JSONObject().apply {
                    put("mappingKey", sim.mappingKey)
                    put("phone", sim.phoneNumber)
                    put("mode", sim.bindMode) // ROOT_ICCID 或 NOROOT_DEVICE
                }
                simsJsonArray.put(simObj)
            }

            // 组装终极遥测数据包 (Telemetry Payload)
            val pongJson = org.json.JSONObject().apply {
                put("action", "PONG")
                put("deviceId", localDeviceId)
                put("deviceName", deviceName)
                put("battery", batteryLevel)
                put("isCharging", isCharging)
                put("isDefaultSms", isDefaultSms)
                put("sims", simsJsonArray)
            }.toString()

            val encryptedPong = com.example.dsim.DsimCryptoUtils.encryptMessage(pongJson, currentPassword)
            val pongMsg = org.eclipse.paho.client.mqttv3.MqttMessage(encryptedPong.toByteArray(Charsets.UTF_8)).apply { qos = 1 }
            mqttClient?.publish(currentTopic, pongMsg)
            
            android.util.Log.d("dSIM_Telemetry", "📡 已向探测机回传完整遥测数据")
        } catch (e: Exception) {
            android.util.Log.e("dSIM_Telemetry", "遥测数据抓取崩溃", e)
        }
    }
    return@launch
}
