                updateNotification("⏳ 正在连接云端隧道...")
                connectAndSubscribe()
            }
        } else {
            // 兜底状态：没配置数据，只挂起守护进程
            updateNotification("⚠️ 守护进程已启动，等待手动接入...")
        }

        return START_STICKY
    }

